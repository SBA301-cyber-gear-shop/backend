# ==========================================
# CYBERSHOP – Environment Variables
# ==========================================
# Copy file này thành .env và điền giá trị thực vào.
# File .env KHÔNG được commit lên git.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cybershop
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# --- Server ---
SERVER_PORT=8080

# --- JWT ---
# Dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=change-me-to-a-strong-random-secret-key
# Thời gian sống Access Token (ms) – mặc định 24h = 86400000
JWT_EXPIRATION_MS=86400000
